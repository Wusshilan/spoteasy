{
  "name": "spoteasy",
  "version": "0.1.46",
  "private": true,
  "description": "Spoteasy",
  "author": "Spoteasy",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "shot": "node scripts/shot.mjs",
    "smoke": "node scripts/smoke.mjs",
    "icon": "node scripts/render-icon.mjs",
    "pack:win": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.spoteasy.app",
    "productName": "Spoteasy",
    "copyright": "Copyright © 2026 Spoteasy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": ["zh-CN", "zh-TW", "en-US"],
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "electronDist": "node_modules/electron/dist",
    "win": {
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spoteasy",
      "artifactName": "Spoteasy-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Spoteasy-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "NeteaseCloudMusicApi": "4.32.0",
    "music-metadata": "^12.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "rcedit": "^5.0.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
